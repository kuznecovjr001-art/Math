<?xml version="1.0" encoding="utf-8"?>
<!-- Данные детей не уходят в облачную копию Google. Перенос на новый телефон кабелем (device-transfer)
     остаётся; иначе — файлом копии из раздела для взрослых. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
